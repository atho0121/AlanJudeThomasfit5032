{
  "firestore": { "rules": "firestore.rules" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.local"],
      "predeploy": ["node copy-data.cjs"]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
  { "source": "/api/**", "function": { "functionId": "api" } },
  { "source": "**", "destination": "/index.html" }
    ]
  }
}